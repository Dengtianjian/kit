{
  "name": "ruyi-kit",
  "version": "1.0.0",
  "description": "RUYI 工具库",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "test": "pnpm test:unit && pnpm test:dom",
    "test:unit": "node --import ./scripts/test-register.mjs --test packages/vue/ui/__tests__/*.test.ts",
    "test:dom": "vitest run",
    "ui:drift-check": "node packages/vue/ui/themes/drift-check.mjs",
    "ci": "pnpm test && pnpm ui:drift-check"
  },
  "author": "",
  "license": "Apache-2.0",
  "peerDependencies": {
    "dayjs": "^1.11.10",
    "naive-ui": "^2.45.0",
    "vite": ">=5.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vicons/carbon": "^0.13.0",
    "@vicons/ionicons5": "^0.13.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "dayjs": "^1.11.10",
    "happy-dom": "^20.14.6",
    "naive-ui": "^2.45.3",
    "vite": "npm:rolldown-vite@^7.3.1",
    "vitest": "^5.1.1",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "exports": {
    "./core/*": {
      "import": "./packages/core/*"
    },
    "./javaScript/*": {
      "import": "./packages/javaScript/*"
    },
    "./vue": {
      "types": "./packages/vue/index.ts",
      "import": "./packages/vue/index.ts"
    },
    "./vue/ui": {
      "types": "./packages/vue/ui/index.ts",
      "import": "./packages/vue/ui/index.ts"
    },
    "./vue/*": {
      "import": "./packages/vue/*"
    },
    "./vue/vite-plugin": {
      "types": "./packages/vue/vite-plugin.ts",
      "import": "./packages/vue/vite-plugin.ts"
    }
  },
  "dependencies": {
    "@tabler/icons-vue": "^3.52.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-bubble-menu": "^3.32.0",
    "@tiptap/extension-code-block-lowlight": "3.32.0",
    "@tiptap/extension-floating-menu": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0",
    "async-validator": "^4.2.5",
    "lowlight": "^3.3.0"
  }
}
